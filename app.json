{
  "expo": {
    "name": "Cookie Clicker",
    "slug": "cookie-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-original.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kixhashroom.cookieclick",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-original.png",
        "backgroundColor": "#f6e6c7"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon-original.png"
    },
    "plugins": [
      ["expo-audio", {
        "microphonePermission": false,
        "recordAudioAndroid": false,
        "enableBackgroundRecording": false,
        "enableBackgroundPlayback": false
      }],
      "expo-asset"
    ]
  }
}
